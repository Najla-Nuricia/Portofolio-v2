{
  "name": "najla-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply najla-portfolio-local --local --config wrangler.local.jsonc && PORTFOLIO_LOCAL=1 astro dev",
    "build": "astro build",
    "preview": "wrangler d1 migrations apply najla-portfolio-local --local --config wrangler.local.jsonc && PORTFOLIO_LOCAL=1 astro preview",
    "test": "vitest run",
    "lint": "oxlint src schema tests astro.config.ts alchemy.run.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxfmt . && oxlint src schema tests astro.config.ts alchemy.run.ts && vitest run && astro check",
    "deploy": "astro build && ALCHEMY_NO_TUI=1 alchemy deploy",
    "deploy:ci": "bun run check && astro build && ALCHEMY_NO_TUI=1 alchemy deploy --stage dev_ryuko --yes"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/solid-js": "^7.1.1",
    "@dnd-kit/solid": "^0.5.1",
    "@effect/platform-bun": "^4.0.6",
    "@effect/platform-node": "^4.0.6",
    "@kobalte/core": "^0.13.14",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/markdown": "^1.0.0",
    "@tanstack/solid-form": "^1.33.5",
    "@tanstack/solid-query": "^5.104.5",
    "@tanstack/solid-table": "^9.3.1",
    "@tanstack/solid-virtual": "^3.13.49",
    "astro": "^7.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "^4.0.6",
    "lucide-solid": "^1.61.0",
    "solid-js": "^1.9.17",
    "solid-motionone": "^1.0.4",
    "solid-sonner": "^0.3.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261023.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "alchemy": "2.0.0-beta.83",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "6.0.3",
    "vite-plus": "^1.4.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "bun@1.3.14"
}
