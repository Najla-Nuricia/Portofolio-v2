---
import { render } from "astro:content";
import ArtGallery from "../components/ArtGallery";
import { listArt } from "../lib/database/art";
import HeroArtwork from "../components/HeroArtwork";
import MotionReveal from "../components/MotionReveal";
import ProjectCollection from "../components/ProjectCollection.astro";
import StudioRail from "../components/StudioRail.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { artUrl } from "../lib/art";
import { getPortfolio } from "../lib/content";
import { formatRange } from "../lib/date";

const { settings, work, projects, education } = await getPortfolio();
const art = (await listArt()).filter((item) => !item.hidden).map((item) => ({
  ...item,
  src: artUrl(item.image),
}));
const workDetails = await Promise.all(work.map(async (item) => ({ item, Content: (await render(item)).Content })));
const educationDetails = await Promise.all(education.map(async (item) => ({ item, Content: (await render(item)).Content })));

---

<BaseLayout title={settings.seoTitle} description={settings.seoDescription} image={projects[0]?.data.cover.src}>
  <StudioRail />
  <main id="main-content" class="pb-20 md:pb-0">
    <section class="container grid min-h-svh grid-cols-2 items-center gap-16 py-16 max-[800px]:grid-cols-1 max-[800px]:gap-10 max-[800px]:py-20">
      <div class="max-w-2xl">
        <div class="mb-8 flex items-center gap-3 text-xs text-muted-foreground">
          <span class="size-2 rounded-full bg-secondary shadow-[0_0_0_4px_color-mix(in_oklab,var(--secondary)_25%,transparent)]"></span>
          <span>{settings.eyebrow}</span>
        </div>
        <h1 class="m-0 text-[clamp(4rem,9vw,8.5rem)] leading-[.82] tracking-[-.055em]">
          Najla<br /><span class="text-primary">Nuricia</span>
        </h1>
        <p class="mt-9 max-w-xl text-[clamp(1rem,1.7vw,1.25rem)] leading-[1.65] text-muted-foreground">{settings.bio}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="button" href="#projects">Explore projects <span aria-hidden="true">↓</span></a>
          <a class="button secondary" href={`mailto:${settings.email}`}>Say hello ↗</a>
        </div>
      </div>

      <HeroArtwork
        client:load
        artworks={projects.map((project) => ({
          src: project.data.cover.src,
          width: project.data.cover.width,
          height: project.data.cover.height,
          title: project.data.title,
        }))}
      />
    </section>

    <section id="work" class="border-y bg-card/75 py-20 shadow-[inset_0_1px_0_white,inset_0_-1px_0_white] sm:py-24">
      <div class="container">
        <div class="grid grid-cols-[minmax(15rem,.48fr)_1fr] gap-12 max-[800px]:grid-cols-1 max-[800px]:gap-10 lg:gap-20">
          <header class="self-start max-[800px]:max-w-xl min-[801px]:sticky min-[801px]:top-16">
            <p class="eyebrow mb-5 text-primary">Experience & education</p>
            <h2 class="m-0 max-w-lg text-[clamp(3.2rem,6.5vw,6.8rem)] leading-[.86] tracking-[-.045em]">
              Drawn to build.
            </h2>
            <p class="mt-7 max-w-sm text-sm leading-7 text-muted-foreground">
              A working practice shaped by game production, independent art, and computer science.
            </p>
          </header>

          <div class="space-y-14">
            <div>
              <div class="mb-3 flex items-center justify-between border-b border-foreground/20 pb-3">
                <h3 class="m-0 text-lg tracking-[-.02em]">Selected experience</h3>
                <span class="font-mono text-[10px] uppercase tracking-[.14em] text-muted-foreground">{work.length} roles</span>
              </div>
              <div>
                {workDetails.map(({ item, Content }, index) => (
                  <MotionReveal client:visible delay={index * 0.08}>
                    <article class="group grid grid-cols-[2.25rem_1fr] gap-x-4 border-b border-foreground/15 py-7 sm:grid-cols-[2.25rem_1fr_auto] sm:gap-x-6">
                      <span class="pt-1 font-mono text-[10px] text-primary">0{index + 1}</span>
                      <div>
                        <p class="mb-2 text-xs text-primary">{item.data.organization}</p>
                        <h4 class="m-0 text-[clamp(1.6rem,3vw,2.4rem)] leading-none tracking-[-.035em] transition-transform duration-300 group-hover:translate-x-1">
                          {item.data.role}
                        </h4>
                        <div class="prose mt-4 max-w-2xl text-sm leading-7 text-muted-foreground"><Content /></div>
                      </div>
                      <time class="col-start-2 mt-4 whitespace-nowrap font-mono text-[10px] uppercase tracking-[.08em] text-muted-foreground sm:col-start-3 sm:row-start-1 sm:mt-1">
                        {formatRange(item.data.startDate, item.data.endDate)}
                      </time>
                    </article>
                  </MotionReveal>
                ))}
              </div>
            </div>

            {education.length > 0 && (
              <div>
                <div class="mb-3 flex items-center justify-between border-b border-foreground/20 pb-3">
                  <h3 class="m-0 text-lg tracking-[-.02em]">Education</h3>
                  <span class="font-mono text-[10px] uppercase tracking-[.14em] text-muted-foreground">Formal study</span>
                </div>
                <div>
                  {educationDetails.map(({ item, Content }, index) => (
                    <MotionReveal client:visible delay={index * 0.08}>
                      <article class="group grid grid-cols-[2.25rem_1fr] gap-x-4 border-b border-foreground/15 py-7 sm:grid-cols-[2.25rem_1fr_auto] sm:gap-x-6">
                        <span class="pt-1 font-mono text-[10px] text-primary">0{index + 1}</span>
                        <div>
                          <p class="mb-2 text-xs text-primary">{item.data.organization}</p>
                          <h4 class="m-0 text-[clamp(1.6rem,3vw,2.4rem)] leading-none tracking-[-.035em] transition-transform duration-300 group-hover:translate-x-1">
                            {item.data.title}
                          </h4>
                          <div class="prose mt-4 max-w-2xl text-sm leading-7 text-muted-foreground"><Content /></div>
                        </div>
                        <time class="col-start-2 mt-4 whitespace-nowrap font-mono text-[10px] uppercase tracking-[.08em] text-muted-foreground sm:col-start-3 sm:row-start-1 sm:mt-1">
                          {formatRange(item.data.startDate, item.data.endDate)}
                        </time>
                      </article>
                    </MotionReveal>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>

    <section id="projects" class="container py-28">
      <div class="mb-14 grid grid-cols-[1fr_.5fr] items-end gap-8 max-[680px]:grid-cols-1">
        <div><p class="eyebrow mb-5 text-primary">Selected projects</p><h2 class="section-title">Pixels with purpose.</h2></div>
        <p class="max-w-sm text-sm leading-7 text-muted-foreground">Original assets and game worlds drawn around clarity, warmth, and a little surprise.</p>
      </div>
      <ProjectCollection projects={projects} />
    </section>

    {art.length > 0 && (
      <section id="art" class="border-y bg-card/70 py-24 sm:py-28">
        <div class="container">
          <div class="mb-12 grid grid-cols-[1fr_.5fr] items-end gap-8 max-[680px]:grid-cols-1">
            <div>
              <p class="eyebrow mb-5 text-primary">Art archive</p>
              <h2 class="section-title">Loose pixels, finished thoughts.</h2>
            </div>
            <p class="max-w-sm text-sm leading-7 text-muted-foreground">
              Illustrations, studies, experiments, and small worlds collected outside the project
              brief.
            </p>
          </div>
          <ArtGallery art={art} client:visible />
        </div>
      </section>
    )}

    <footer id="contact" class="border-t bg-card">
      <div class="container py-16 sm:py-20">
        <div class="grid grid-cols-[minmax(0,1fr)_auto] items-end gap-10 max-[700px]:grid-cols-1 max-[700px]:gap-8">
          <div>
            <p class="eyebrow mb-4 text-primary">Available for selected projects</p>
            <h2 class="m-0 max-w-3xl text-[clamp(2.5rem,6vw,5.25rem)] leading-[.94] tracking-[-.04em]">
              Let’s build something worth playing.
            </h2>
          </div>
          <a
            class="group inline-flex min-h-12 items-center justify-between gap-8 border-b border-foreground pb-2 text-base no-underline transition-colors hover:border-primary hover:text-primary max-[700px]:w-full"
            href={`mailto:${settings.email}`}
          >
            <span>{settings.email}</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">↗</span>
          </a>
        </div>

        <div class="mt-14 grid grid-cols-[1fr_auto] items-center gap-6 border-t pt-5 text-xs text-muted-foreground max-[620px]:grid-cols-1 max-[620px]:gap-4">
          <span>© {new Date().getFullYear()} {settings.name}</span>
          <nav aria-label="Social links" class="flex flex-wrap gap-x-6 gap-y-3">
            <a class="hover:text-foreground" href={settings.itchUrl}>Itch.io</a>
            <a class="hover:text-foreground" href={settings.githubUrl}>GitHub</a>
            <a class="hover:text-foreground" href={settings.linkedinUrl}>LinkedIn</a>
          </nav>
        </div>
      </div>
    </footer>
  </main>
</BaseLayout>
