{
  "name": "najla-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "lint": "oxlint src schema tests astro.config.ts alchemy.run.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxfmt . && oxlint src schema tests astro.config.ts alchemy.run.ts && vitest run && astro check",
    "deploy": "astro build && ALCHEMY_NO_TUI=1 alchemy deploy",
    "deploy:ci": "bun run check && astro build && ALCHEMY_NO_TUI=1 alchemy deploy --stage dev_ryuko --yes"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.3",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/solid-js": "^7.0.1",
    "@dnd-kit/solid": "^0.5.0",
    "@effect/platform-bun": ">=4.0.0-beta.97|| >=4.0.0",
    "@effect/platform-node": ">=4.0.0-beta.97|| >=4.0.0",
    "@kobalte/core": "^0.13.12",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/markdown": "^0.0.12",
    "@tanstack/solid-form": "^1.33.2",
    "@tanstack/solid-query": "^5.101.4",
    "@tanstack/solid-table": "^8.21.3",
    "@tanstack/solid-virtual": "^3.13.36",
    "astro": "^7.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "effect": "^4.0.0-beta.102",
    "lucide-solid": "^1.24.0",
    "solid-js": "^1.9.14",
    "solid-motionone": "^1.0.4",
    "solid-sonner": "^0.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudflare/workers-types": "^5.20260729.1",
    "alchemy": "2.0.0-beta.62",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^6",
    "vite-plus": "^0.2.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
